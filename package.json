{
  "name": "arcade-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multiplayer arcade hub – races and more",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production npx tsx server/src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/static": "^8.0.2",
    "@fastify/websocket": "^11.0.1",
    "ws": "^8.18.0",
    "uuid": "^11.0.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "three": "^0.170.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
